# Copy to /etc/phone-shi/phone-shi.env and chmod 600.
ANDROID_SDK_ROOT=/opt/android-sdk
ANDROID_HOME=/opt/android-sdk
ANDROID_AVD_HOME=/var/lib/phone-shi/.android/avd
PHONE_BACKUPS=/var/lib/phone-shi/backups
ACCOUNT_PANEL_DATA=/var/lib/phone-shi/control-panel
IG_VARIANTS_PATH=/opt/phone-shi/control-panel/vendor/variants.py
DISPLAY=:99

# Generate with: openssl rand -hex 32
# Keep this secret. It is required if the panel is ever bound beyond localhost.
CONTROL_PANEL_TOKEN=replace-with-a-long-random-token

# Optional: HTTPS or private-network origin used by phone QR/share links.
# Without this, links use the browser's current CRM origin (normally localhost).
PHONE_SHI_SHARE_BASE_URL=
PHONE_SHI_SHARE_TTL_SECONDS=86400
