{
  "app": "com.tinder",
  "terminal_screen": "locked-video-selfie-manual-stop",
  "screens": [
    {"screen": "notification-permission", "click": "Don’t allow"},
    {"screen": "welcome-terms-and-login", "click": "Continue with Phone Number"},
    {"screen": "google-number-hint", "action": "KEYCODE_BACK"},
    {"screen": "phone-entry", "field": "com.tinder:id/phoneNumberInputView", "value_parameter": "phone_number", "read_back": true, "click": "Next"},
    {"screen": "verification-code", "fields": "com.tinder:id/otp_input_view_0..5", "value_parameter": "sms_code", "preserve_leading_zero": true, "click_if_still_on_same_screen_and_read_back_matches": "Next"},
    {"screen": "verification-code-invalid", "action": "stop"},
    {"screen": "house-rules", "click": "I agree"},
    {"screen": "first-name", "field": "com.tinder:id/onboarding_name_edit_text", "value_parameter": "first_name", "read_back": true, "click": "Next"},
    {"screen": "profile-welcome", "click": "Let’s go"},
    {"screen": "birth-date", "input_layout": "MM/DD/YYYY", "value_parameter": "birth_date", "read_back": true, "click": "Next"},
    {"screen": "gender", "value_parameter": "gender", "visibility_parameter": "show_gender_on_profile", "read_back_visibility": true, "click": "Next"},
    {"screen": "distance-preference", "observed_value": "50 Mi", "click": "Next"},
    {"screen": "relationship-goals", "value_parameter": "relationship_goal", "observed_choice": "Still figuring it out", "click": "Next"},
    {"screen": "school", "click": "Skip"},
    {"screen": "lifestyle", "action": "select_one_random_reviewed_option_per_question", "selection_count": 4},
    {"screen": "personality", "action": "select_one_random_reviewed_option_per_question", "selection_count": 4},
    {"screen": "interests", "action": "select_random_distinct_reviewed_options", "selection_count": [2, 3]},
    {"screen": "photos-manual-stop", "action": "open_first_empty_photo_slot"},
    {"screen": "android-photo-picker", "value_parameter": "photo_paths", "require_exact_library_hash_match": true, "observed_selected_count": 4, "click": "Add (4)"},
    {"screen": "photo-editor", "require_four_previews": true, "click": "Done"},
    {"screen": "photos-manual-stop", "require_four_added_photos": true, "click": "Next"},
    {"screen": "bio-and-prompt", "click": "Skip"},
    {"screen": "location-rationale", "click": "Allow"},
    {"screen": "location-permission", "click": "While using the app", "precision": "unchanged"},
    {"screen": "location-accuracy-prompt", "click": "No thanks"},
    {"screen": "human-verification-manual-stop", "action": "stop", "covers": ["CAPTCHA", "robot check", "face verification", "photo verification", "video selfie"], "do_not_interact": true},
    {"screen": "locked-video-selfie-manual-stop", "action": "stop", "do_not_click": "Get verified"},
    {"screen": "unknown", "action": "stop"}
  ]
}
